          "rawSql": "SELECT\r\n  $__timeGroup(timestamp, '1m') AS time,\r\n  SUM(emotion = 'happy')   AS happy,\r\n  SUM(emotion = 'sad')     AS sad,\r\n  SUM(emotion = 'neutral') AS neutral,\r\n  SUM(emotion = 'angry')   AS angry,\r\n  SUM(emotion = 'fear')    AS fear\r\nFROM emotions\r\nWHERE $__timeFilter(timestamp)\r\nGROUP BY time\r\nORDER BY time;\r\n",
